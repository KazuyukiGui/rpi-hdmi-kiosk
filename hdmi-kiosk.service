# テンプレート。install.sh が @KIOSK_USER@ / @KIOSK_UID@ を置き換えて
# /etc/systemd/system/ に配置する。
[Unit]
Description=HDMI browser kiosk
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=@KIOSK_USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/@KIOSK_UID@
EnvironmentFile=/etc/hdmi-kiosk/kiosk.env
ExecStart=/usr/local/lib/hdmi-kiosk/kiosk-start.sh
Restart=always
RestartSec=5
# NoNewPrivileges= などのサンドボックス設定は付けない。
# snap 版 Chromium は setuid の snap-confine で起動するため、付けると起動できなくなる。
# 代わりに「権限のない専用ユーザー」と「snap の AppArmor 閉じ込め」で保護する。

[Install]
WantedBy=graphical.target
